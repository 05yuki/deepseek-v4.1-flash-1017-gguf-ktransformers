+vec_dot_q5_0_q8_1_impl(const int* vl, const int* vh, const int* u, const float& d5, const half2& ds8) {
+#if defined __CUDA_ARCH__ && __CUDA_ARCH__ >= 610 || defined USE_ROCM
+  int sumi = 0;
+
+#pragma unroll
+  for (int i = 0; i < vdr; ++i) {
