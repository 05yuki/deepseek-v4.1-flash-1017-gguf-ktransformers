+def _mirror_view(i: int, k: int, n: int) -> torch.Tensor:
+    """The first n bytes of layer i as laid out in bounce k (the layer starts at byte 4096 of the bounce)."""
+    return STATE["mirror"]["bounces"][k][4096 : 4096 + n]
