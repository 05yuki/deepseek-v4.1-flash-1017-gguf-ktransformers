+    vi0 |= (vh[i] << 4) & 0x00000010;        // 0 ->  4
+    vi0 |= (vh[i] << 11) & 0x00001000;       // 1 -> 12
+    vi0 |= (vh[i] << 18) & 0x00100000;       // 2 -> 20
+    vi0 |= (vh[i] << 25) & 0x10000000;       // 3 -> 28
