+# ROW_STEP rows (ids -1, weights 0), so graphs and inputs exist for a few row
+# counts only and the lend's accounting of the scratch holds.
+ROW_STEP = int(os.environ.get("KT_GPU_STREAM_ROW_STEP", "2048") or 0)
+
