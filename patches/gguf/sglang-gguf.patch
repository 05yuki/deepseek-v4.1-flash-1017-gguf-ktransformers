+static __device__ __forceinline__ float
+vec_dot_q5_K_q8_1(const void* __restrict__ vbq, const block_q8_1* __restrict__ bq8_1, const int& iqs) {
+  const block_q5_K* bq5_K = (const block_q5_K*)vbq;
