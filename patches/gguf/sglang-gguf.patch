+  const int blocks_per_warp = vdr * WARP_SIZE / qi;
+  const block_q8_1* ys[NM];
+#pragma unroll
+  for (int m = 0; m < NM; ++m) {
+    ys[m] = (const block_q8_1*)(((const int*)vy) + (members[m] / topk) * token_stride);
+  }
+  float tmp[NM][KT_RPW];
+#pragma unroll
+  for (int m = 0; m < NM; ++m) {
+#pragma unroll
+    for (int r = 0; r < KT_RPW; ++r) {
