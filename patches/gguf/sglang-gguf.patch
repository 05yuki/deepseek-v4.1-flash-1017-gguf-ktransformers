+  const int kqsx = k % QI6_K;  // == k if QK_K == 256
+
+  const block_q6_K* bx0 = (const block_q6_K*)vx;
+
+#pragma unroll
+  for (int i0 = 0; i0 < mmq_y; i0 += nwarps) {
+    int i = i0 + i_offset;
