+        if kind == "pinned":
+            bounce[4096 + o : 4096 + o + nb].copy_(m["residual"][src : src + nb])
+            continue
+        fd, foff = src
+        direct = m["mode"] == "file"
+        for a in range(0, nb, _MPIECE):
+            futs.append(m["pool"].submit(piece, fd, foff + a, 4096 + o + a, min(_MPIECE, nb - a), direct))
