+    const int qh1 = ((qh >> (2 * (kqsx / (QI5_K / 4)) + 1)) << 4) & 0x10101010;
+
+    const int kq0 = ky - ky % (QI5_K / 2) + k % (QI5_K / 4) + 0;
+    const int kq1 = ky - ky % (QI5_K / 2) + k % (QI5_K / 4) + (QI5_K / 4);
