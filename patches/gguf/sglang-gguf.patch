+// contiguous v/x values
+static __device__ __forceinline__ float vec_dot_q3_K_q8_1_impl_mmvq(
+    const int& vl,
+    const int& vh,
+    const int* __restrict__ u,
+    const uint8_t* __restrict__ scales,
+    const int& scale_offset,
+    const float& d3,
