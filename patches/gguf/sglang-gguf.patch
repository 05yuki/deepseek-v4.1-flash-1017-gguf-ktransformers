+        ev.synchronize()
+    m["reads"][i] = m["pool"].submit(_mirror_read_layer, i, k)
+
+
+def _mirror_wait(i: int) -> None:
+    m = STATE["mirror"]
+    _mirror_submit(i)
+    m["reads"].pop(i).result()
