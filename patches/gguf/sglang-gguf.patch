+            w = raw[:n * pb].view(n * rows, rowbytes)
+            out.copy_(ggml_dequantize(w, qt, n * rows, cols, torch.bfloat16).view(n, rows, cols))
+        else:
+            DQ.dequant_experts(raw, pb, qt, n, rows, cols, out)
