+    k = i % 2
+    ev = STATE.get("pf_ready", [None, None])[k]
+    if ev is not None and STATE.get("pf_bounce_used", [False, False])[k]:
+        ev.synchronize()
+    m["reads"][i] = m["pool"].submit(_mirror_read_layer, i, k)
+
