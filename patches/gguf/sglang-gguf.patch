+    x_qh[i * (WARP_SIZE_GGUF / 2) + i / 2 + k % (WARP_SIZE_GGUF / 2)] =
+        ~get_int_from_uint8(bxi->hmask, k % (QI3_K / 2));
+  }
+
+#pragma unroll
+  for (int i0 = 0; i0 < mmq_y; i0 += nwarps * 4) {
+    int i = i0 + i_offset * 4 + k / (WARP_SIZE_GGUF / 4);
+    if (need_check) {
