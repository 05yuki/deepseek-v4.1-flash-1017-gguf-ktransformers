+            while got < hi - lo:
+                r = os.preadv(fd, [mv[dst + got : dst + (hi - lo)]], lo + got)
+                if r <= 0:
+                    raise IOError(f"short mirror read at {lo + got}")
+                got += r
+        else:
+            got = 0
+            while got < nb:
+                r = os.preadv(fd, [mv[boff + got : boff + nb]], foff + got)
+                if r <= 0:
+                    raise IOError(f"short GGUF read at {foff + got}")
+                got += r
+
